# Required: canonical non-anchor directory roots, separated by the OS path separator.
# Filesystem anchors such as / are prohibited.
MAESTRO_ALLOWED_ROOTS=/absolute/path/to/authorized/repositories

# Configure exactly one explicit authentication source. No example secret is included.
MAESTRO_CODEX_AUTH_FILE=/absolute/path/to/codex-auth.json
# MAESTRO_CODEX_API_KEY=

# Required by the normal runtime: non-secret PostgreSQL coordinates plus an owner-only (0400 or
# 0600), regular, non-symlink writer password file. Password-bearing DSNs are not supported.
MAESTRO_AUDIT_WRITER_HOST=localhost
MAESTRO_AUDIT_WRITER_PORT=5432
MAESTRO_AUDIT_WRITER_DATABASE=maestro
MAESTRO_AUDIT_WRITER_USER=audit_writer
MAESTRO_AUDIT_WRITER_PASSWORD_FILE=/absolute/path/to/audit-writer-password

# Bootstrap, migration-owner, and SELECT-only reader credentials use their own corresponding
# MAESTRO_AUDIT_BOOTSTRAP_*, MAESTRO_AUDIT_MIGRATION_*, and MAESTRO_AUDIT_READER_* names. Do not
# supply those credentials to the normal Maestro runtime.

MAESTRO_CODEX_MODEL=gpt-5.4
MAESTRO_VERIFIER_TIMEOUT_SECONDS=300
MAESTRO_MAX_CONCURRENCY=2
MAESTRO_MAX_QUEUE_SIZE=4
MAESTRO_MAX_QUESTION_CHARS=4000
MAESTRO_MAX_CONTEXT_CHARS=8000
MAESTRO_MAX_RESULT_BYTES=65536
MAESTRO_MAX_AGENT_OUTPUT_BYTES=131072
MAESTRO_MAX_EVIDENCE_ITEMS=20
MAESTRO_MAX_CONFLICTS=10
MAESTRO_MAX_REPOSITORY_FILES=10000
MAESTRO_MAX_REPOSITORY_BYTES=67108864
MAESTRO_MAX_FILE_BYTES=1048576
MAESTRO_LOG_LEVEL=INFO

# Hardened container launcher settings. Defaults are shown; UID/GID normally come from the host.
MAESTRO_DOCKER_IMAGE=maestro-verifier:local
MAESTRO_DOCKER_MEMORY=2g
MAESTRO_DOCKER_CPUS=2
MAESTRO_DOCKER_PIDS_LIMIT=256
MAESTRO_DOCKER_TMPFS_SIZE=512m
# MAESTRO_DOCKER_UID=1000
# MAESTRO_DOCKER_GID=1000
